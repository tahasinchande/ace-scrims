# ==============================================================================
# ACE SCRIMS - ENVIRONMENT CONFIGURATION & SETUP INSTRUCTIONS
# ==============================================================================

# 1. Database (PostgreSQL / Neon / Supabase / Cloud SQL)
# Required for persistent storage of users, scrims, bookings, and payments.
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# 2. Better Auth & Public Site URL
# Generate a secret via: openssl rand -base64 32
BETTER_AUTH_SECRET=your_32_char_random_secret_here
# Production deployment URL
BETTER_AUTH_URL=https://www.acescrims.online
NEXT_PUBLIC_APP_URL=https://www.acescrims.online

# 3. Google OAuth Credentials (Optional)
# Obtain from Google Cloud Console > APIs & Services > Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 4. Email Service (Verification Emails & Password Resets)
# ------------------------------------------------------------------------------
# OPTION A: RESEND (Recommended)
# 1. Sign up at https://resend.com and generate an API key.
# 2. To send to any recipient, verify your custom domain in Resend Dashboard.
# 3. If using the free test domain, sender must be onboarding@resend.dev.
RESEND_API_KEY=
EMAIL_FROM=ACE SCRIMS <noreply@mail.acescrims.online>

# OPTION B: SENDGRID (Fallback)
SENDGRID_API_KEY=

# OPTION C: SMTP / GMAIL (Alternative)
# Use your own SMTP server (Brevo, SendGrid SMTP, Amazon SES, or Gmail App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_char_app_password
SMTP_SECURE=false
SMTP_FROM=Ace Scrims <your_email@gmail.com>

# 5. Storage & Media Uploads (Solves Vercel Read-Only File System & 413 Limits)
# ------------------------------------------------------------------------------
# Option A: VERCEL BLOB (Recommended on Vercel)
# 1. In your Vercel Dashboard, go to the Storage tab.
# 2. Click "Create Database" > "Blob".
# 3. Connect the Blob store to your project.
# 4. Vercel will automatically set BLOB_READ_WRITE_TOKEN, enabling direct client uploads up to 500MB.
BLOB_READ_WRITE_TOKEN=

# Option B: CLOUDINARY (Alternative Storage)
# 1. Sign up at https://cloudinary.com
# 2. Add an Unsigned Upload Preset in Settings > Upload > Upload Presets.
# 3. Provide your Cloud Name and Preset:
CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_UPLOAD_PRESET=ml_default
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=ml_default
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# 6. Payment Gateway Configuration (bKash / Nagad / Tap)
UDDOKTAPAY_API_KEY=your_payment_gateway_api_key_here
UDDOKTAPAY_BASE_URL=https://pay.acescrims.online/api
UDDOKTAPAY_PANEL_URL=https://pay.acescrims.online/api
UDDOKTAPAY_PAYMENT_LINK_URL=https://pay.acescrims.online/paymentlink/default/BDT
